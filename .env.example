# ---------------------------------------------------------------------------
# Nexerra Talent OS — environment template
# Copy to `.env` for local dev, or set these as real environment variables in
# your hosting platform. Never commit a real `.env`.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------
# Signing key for JWTs. Use >=32 random bytes, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-openssl-rand-hex-32

# Encryption key for stored Gmail OAuth tokens (independent of JWT_SECRET).
# `openssl rand -hex 32`. If omitted it falls back to JWT_SECRET (not advised).
TOKEN_ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# Database. SQLite default is dev-only; use PostgreSQL in production.
# DATABASE_URL=sqlite:///./nexerra.db
DATABASE_URL=postgresql+psycopg://nexerra:password@localhost:5432/nexerra

# Public origins (used for OAuth redirects, invite links and email links).
PUBLIC_API_URL=https://api.example.com
FRONTEND_URL=https://app.example.com

# First platform administrator (bootstrap). Override before first deploy.
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_NAME=Platform Administrator
BOOTSTRAP_PASSWORD=change-me-strong-password

# Persistent path for uploaded resumes (mount a volume in production).
UPLOAD_DIR=/data/uploads

# --- Google / Gmail resume ingestion --------------------------------------
# Without these the connector runs in offline demo mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/email/gmail/callback

# --- Outbound email (invitations + candidate email) -----------------------
# Without SMTP the app uses a mock provider and no real mail is sent.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_USE_TLS=true

# --- Optional tuning ------------------------------------------------------
JWT_EXPIRES_MINUTES=1440
INVITE_EXPIRES_HOURS=72
MAX_RESUME_BYTES=10485760
# DEMO_INBOX_DIR=./uploads/inbox
